@using Turing.Core.MachineTape
@using Turing.Core.Rules
<div>
	@if (Model.IsBlank)
	{
		<TapeSymbolLabel Symbol="Model"></TapeSymbolLabel>
	}
	else
	{
		<input type="text" @bind="_text" @bind:after="OnTextChanged" />
	}
</div>

@code {
	[Parameter]
	[EditorRequired]
	public TapeSymbol Model { get; set; }

	string _text = String.Empty;

	void OnTextChanged()
	{
		Model.Value = _text;
		OnValueChanged();
	}

	[Parameter]
	public EventCallback<TapeSymbol> ValueChanged { get; set; }

	void OnValueChanged() =>
		ValueChanged.InvokeAsync(Model);

	protected override void OnParametersSet()
	{
		_text = Model.Value ?? String.Empty;
	}
}
